  "provenance": {
    "generated_by": "tools/evaluate_ge_rdsr.py",
    "question": "Does the open-table reconstruction predict GE CTDIvol? The archive cannot answer this because GE records CTDIvol in no sampled image header, so the reference is taken from the scanner's own Radiation Dose SR instead.",
    "what_this_tests": "the dose model (table coefficient, mAs per rotation, pitch) on GE scanners. It does NOT test the metadata-gap recovery path, because the technique is read from a structured report rather than reconstructed from a de-identified image header.",
    "independence": "Events are not independent patients. The comparison draws several events from each study, and events within a study share a scanner, a calibration and a session.",
    "coefficients": {
      "name": "MIRDct normalized CTDI database",
      "citation": "Dinwiddie LE, Baggett JM, Kofler JM, et al. Survey of normalized CTDIvol values across four major computed tomography vendors for use in the MIRDct software. J Appl Clin Med Phys. 2026;27(2):e70473. doi:10.1002/acm2.70473",
      "doi": "10.1002/acm2.70473",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "source_file": "ACM2-27-e70473-s001.xlsx",
