  "provenance": {
    "source_file": "the reference implementationjp.m",
    "source_description": "the reference implementation (LISIT) MATLAB dose calculator, read-only reference. Constants follow the CT-Expo methodology (nCTDIair / nCTDIw per scanner series) with ICRP-103 DLP->E conversion factors.",
    "extracted_by": "tools/extract_matlab_tables.py",
    "reference": "AAPM TG-204 (2011) size-specific dose estimate conversion factors",
    "column_layout": {
      "etab*": [
