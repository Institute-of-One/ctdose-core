# outside this repository. See README, "Provenance of the coefficient tables".
*.m
*.fig
*.exe
*.mp4
MATLAB_Runtime_*
MATLAB_Runtime_*.zip

# Patient / clinical imaging. The only DICOM that belongs here is the scrubbed
# dummy-patient fixture under data/DOSE_TARO/.
*.DCM
*.ima
*.IMA
*.nii
*.nii.gz
!data/DOSE_TARO/*.dcm

# Segmentation output and downloaded archives
_ctdose_segmentation/
*.zip
tcia_downloads/

